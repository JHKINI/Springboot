<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kopo.aisw.springboot_basic.mapper.BoardMapper">

    <!-- Oracle DB 버전 -->
    <insert id="save" parameterType="Board">
        INSERT INTO tb_board (title, content, user_id)
        VALUES (#{title}, #{content}, #{userId})
        <selectKey keyProperty="boardId" resultType="Long" order="AFTER">
            select board_seq.currval from dual
        </selectKey>
    </insert>

    <select id="findById" parameterType="Long" resultType="Board">
        SELECT * FROM tb_board WHERE board_id = #{boardId}
    </select>

    <select id="findAll" resultType="Board">
        SELECT * FROM tb_board ORDER BY board_id DESC
    </select>

    <update id="update" parameterType="Board">
        UPDATE tb_board
        SET title = #{title}, content = #{content}
        WHERE board_id = #{boardId}
    </update>

    <delete id="delete" parameterType="Long">
        DELETE FROM tb_board WHERE board_id = #{boardId}
    </delete>

    <update id="updateViewCount" parameterType="Long">
        UPDATE tb_board
        SET view_count = view_count + 1
        WHERE board_id = #{boardId}
    </update>


    <!-- 검색 조건 -->
    <sql id="criteria">
        <trim prefix="WHERE (" suffix=")" prefixOverrides="OR">
            <foreach item="type" collection="typeArr">
                <trim prefix="OR">
                    <choose>
                        <when test="type == 'T'.toString()">
                            title LIKE '%' || #{keyword} || '%'
                        </when>
                        <when test="type == 'C'.toString()">
                            content LIKE '%' || #{keyword} || '%'
                        </when>
                        <when test="type == 'W'.toString()">
                            user_id LIKE '%' || #{keyword} || '%'
                        </when>
                    </choose>
                </trim>
            </foreach>
        </trim>
    </sql>

    <!-- 페이징 + 검색 -->
    <select id="getListWithPaging"
            parameterType="kopo.aisw.springboot_basic.domain.Criteria"
            resultType="kopo.aisw.springboot_basic.domain.Board">

        SELECT *
        FROM (
        SELECT ROWNUM NUM, BOARD.*
        FROM (
        SELECT *
        FROM tb_board
        <if test="typeArr != null and typeArr.length > 0 and keyword != null and keyword != ''">
            <include refid="criteria"/>
        </if>
        ORDER BY board_id DESC
        ) BOARD
        )
        WHERE NUM BETWEEN #{offset} + 1
        AND #{offset} + #{amount}

    </select>

    <!-- 검색 결과 전체 개수 -->
    <select id="getTotalCount"
            parameterType="kopo.aisw.springboot_basic.domain.Criteria"
            resultType="int">

        SELECT COUNT(*)
        FROM tb_board
        <if test="typeArr != null and typeArr.length > 0 and keyword != null and keyword != ''">
            <include refid="criteria"/>
        </if>

    </select>
    <!-- 기존 코드 유지 : 마지막 부분에 추가 -->


    <!-- 파일 저장 -->
    <insert id="saveFile" parameterType="kopo.aisw.springboot_basic.domain.FileInfo">
        INSERT INTO file_info (
            board_id, original_file_name, saved_file_name,
            file_path, file_size, file_type
        ) VALUES (
                     #{boardId}, #{originalFileName}, #{savedFileName},
                     #{filePath}, #{fileSize}, #{fileType}
                 )
    </insert>

    <!-- 파일 조회 -->
    <select id="findFileById"
            parameterType="java.lang.Long"
            resultType="kopo.aisw.springboot_basic.domain.FileInfo">
        SELECT * FROM file_info
        WHERE file_id = #{fileId}
    </select>

    <!-- 게시글의 파일 목록 조회 -->
    <select id="findFilesByBoardId"
            parameterType="java.lang.Long"
            resultType="kopo.aisw.springboot_basic.domain.FileInfo">
        SELECT *
        FROM file_info
        WHERE board_id = #{boardId}
        ORDER BY file_id
    </select>

    <!-- 파일 삭제 -->
    <delete id="deleteFile" parameterType="java.lang.Long">
        DELETE FROM file_info
        WHERE file_id = #{fileId}
    </delete>

    <!-- 게시글의 모든 파일 삭제 -->
    <delete id="deleteFilesByBoardId" parameterType="java.lang.Long">
        DELETE FROM file_info
        WHERE board_id = #{boardId}
    </delete>

</mapper>